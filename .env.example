# Copia este archivo a .env y ajusta valores.

# Opción A: URL completa (tiene prioridad si la defines)
# DATABASE_URL=postgresql+psycopg2://postgres:TU_CLAVE@localhost:5432/conectados_directo

# Opción B: variables sueltas (usuario por defecto: postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_CLAVE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=conectados_directo

# JWT
JWT_SECRET=change-me-in-production

# Migraciones (schema + sincronización de ui_components con el front)
# alembic upgrade head


# CORS: orígenes adicionales (Vite y puertos fijos ya van por código). Útil si abres el front por IP de red.
# CORS_EXTRA_ORIGINS=http://192.168.1.10:5173,http://10.0.0.5:5173

# Multi-tenant por subdominio (slug = primer segmento del host respecto al dominio base)
# Ej.: front en http://mi-empresa.localhost:5173 con TENANT_BASE_DOMAINS=localhost → slug "mi-empresa"
# Si el API está en otro host, el front debe enviar X-Forwarded-Host con el host del navegador.
# TENANT_BASE_DOMAINS=localhost,127.0.0.1,mi-dominio.com
# DEFAULT_TENANT_SLUG=default
# TENANT_SUBDOMAIN_STRICT=true

# Servidor (solo si usas `python main.py` en la raíz del back)
# PORT=8000
# HOST=0.0.0.0
# UVICORN_RELOAD=1

# WhatsApp Cloud API (opcional)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# ID de la cuenta WhatsApp Business (WABA) en Meta — necesario para crear plantillas desde el portal:
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# o equivalente:
# WABA_ID=
# Ventana de sesión (horas) desde el último mensaje entrante del cliente (Meta usa 24).
# WHATSAPP_CUSTOMER_CARE_WINDOW_HOURS=24

# Celery + Redis (mensajes programados: la API encola con ETA; el worker envía por WhatsApp)
# Arranque del worker (carpeta back, venv activo):
#   celery -A app.celery_app:celery_app worker -l info
# Redis local (Docker): docker run -d -p 6379:6379 --name redis redis:7-alpine
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
